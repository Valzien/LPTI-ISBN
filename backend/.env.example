APP_NAME="LPTI-ISBN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Produksi ------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false                # WAJIB: cegah stack trace & isi .env bocor
# APP_URL=https://api.domain-anda.id
# LOG_LEVEL=warning              # hindari log berisi data pribadi
# SESSION_SECURE_COOKIE=true     # aktifkan ketika sudah di belakang HTTPS
# SANCTUM_STATEFUL_DOMAINS=domain-frontend-anda.id
#   ^ hanya diperlukan bila memakai mode SPA stateful. Arsitektur LPTI-ISBN
#     memakai BFF: token dikirim sebagai Authorization: Bearer dari sisi
#     server, sehingga tidak bergantung pada daftar domain ini.
# Lihat docs/DEPLOYMENT.md untuk checklist lengkap sebelum produksi.

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lpti_isbn
DB_USERNAME=root
DB_PASSWORD=
# Produksi: jangan gunakan root tanpa password. Buat user khusus yang hanya
# memiliki hak pada database lpti_isbn.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
