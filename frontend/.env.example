# URL dasar REST API Laravel (backend). Hanya dibaca di sisi server.
# Salin berkas ini menjadi .env.local lalu sesuaikan bila perlu.
API_URL=http://localhost:8000

# Produksi:
# API_URL=https://api.domain-anda.id
#
# JANGAN memakai prefix NEXT_PUBLIC_ pada API_URL. Variabel ber-prefix
# NEXT_PUBLIC_ ikut dibundel ke kode browser dan akan membocorkan alamat
# backend. Seluruh panggilan API dilakukan dari sisi server (BFF) melalui
# Server Actions dan Route Handlers.
#
# Lihat docs/DEPLOYMENT.md untuk instruksi build & deploy produksi.
